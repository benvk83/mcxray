# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# Per-machine Claude Code settings
.claude/settings.local.json

# Results. Calculations live outside this repository (see README); these
# patterns keep the output of running the shipped example out of it.
*.npz
*.pkl
*.png
*.log
*.out

# Orbital files: ORCA .gbw and the MOKIT intermediates made from it
*.gbw
*.mkl
*.fch

# ORCA scratch and by-products
*.densities
*.densitiesinfo
*.tmp
*.tmp.*
*.bibtex
*.property.txt
*_trj.xyz

# Test fixtures are the exception
!tests/data/*.pkl
!tests/data/*.npz
