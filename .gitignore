# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Per-machine Claude Code settings
.claude/settings.local.json

# Large binary results, regenerated by steps 02-07
*.npz
*.pkl

# Orbital files: ORCA .gbw and the MOKIT intermediates made from it.
# The .gbw files are inputs, not outputs -- keep a copy elsewhere.
*.gbw
*.mkl
*.fch

# ORCA scratch
*.densities
*.tmp
*.tmp.*

# run/: track only what a calculation is started from -- geometries,
# ORCA inputs, system files, submit scripts and experimental data.
# Everything a job writes (logs, ORCA output, figures, reports) stays out.
run/**
!run/**/
!run/**/*.xyz
!run/**/*.inp
!run/**/*.toml
!run/**/*.sh
!run/cr/crddpd/Crddpd2_0T_xas.txt
run/**/*_trj.xyz
